# Educational Intelligence Copilot — Team C
# Copy this file to .env.local and fill in real values there.
# .env.local is git-ignored and must never be committed.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
MONGODB_URI=

# ---------------------------------------------------------------------------
# Authentication — Auth.js
# ---------------------------------------------------------------------------
AUTH_SECRET=
# MVP M6: also reused (read-only) by services/storage.ts's local
# development storage mock to build a FULLY QUALIFIED file_url for Team
# 4A's canonical /v1/ingest -- must be reachable from wherever Team 4A
# is running (e.g. http://localhost:3000 when 4A runs on the same
# machine at 127.0.0.1:8001).
AUTH_URL=http://localhost:3000
# Auth.js v5 requires explicit permission to trust the Host header on any
# environment it can't verify automatically (this is what "UntrustedHost:
# Host must be trusted" means). lib/auth.ts already sets `trustHost: true`
# in code; AUTH_TRUST_HOST=true is set here too as a second, independent
# way for Auth.js to pick up the same setting via environment variable —
# so a fresh checkout works correctly even before anyone touches
# lib/auth.ts. If you still see UntrustedHost after setting these, delete
# .next and restart the dev server — Turbopack/Next.js can serve a stale
# cached build that predates an auth-config change.
AUTH_TRUST_HOST=true

# ---------------------------------------------------------------------------
# Object storage (see docs/decisions.md §8 for the local-storage-mock
# rationale). Leave blank to use the local-storage development mock —
# only set these if a real object storage provider is actually wired up.
# ---------------------------------------------------------------------------
STORAGE_PROVIDER=
STORAGE_API_KEY=
STORAGE_API_SECRET=

# ---------------------------------------------------------------------------
# Team A — Ingestion API
#
# TEAM_A_API_URL is the INTERNAL, service-to-service base URL (e.g.
# http://localhost:8001) -- browsers never call this; only 4C's own
# server-side code does. There is no API key variable here -- authentication
# is the internal service JWT (see the SERVICE_JWT_* variables below),
# minted fresh per request from server-verified identity, never a static
# shared secret. Set USE_MOCK_TEAM_A=false and TEAM_A_API_URL to a real,
# reachable Team4A instance for real (non-mocked) integration.
# ---------------------------------------------------------------------------
USE_MOCK_TEAM_A=true
TEAM_A_API_URL=

# ---------------------------------------------------------------------------
# Team B — Query/RAG API
#
# TEAM_B_API_URL is the INTERNAL, service-to-service base URL -- browsers
# never call this. Same service-JWT authentication model as Team A above.
# ---------------------------------------------------------------------------
USE_MOCK_TEAM_B=true
TEAM_B_API_URL=

# ---------------------------------------------------------------------------
# Internal service JWT signing (lib/serviceJwt.ts) -- used to authenticate
# every real (non-mocked) call to Team A and Team B. See
# docs/INTEGRATION.md and docs/ENVIRONMENT.md for the full contract
# (which claims each service checks, and how to generate a real keypair).
#
# Variable names only, documented here for discoverability — NO real
# private key material belongs in this repository, in this file, or in
# any committed file. `SERVICE_JWT_PRIVATE_KEY` must be a PKCS8 PEM ES256
# private key, provisioned via your actual deployment's secret-management
# mechanism, never committed.
# ---------------------------------------------------------------------------
SERVICE_JWT_PRIVATE_KEY=
SERVICE_JWT_KID=
SERVICE_JWT_ISSUER=
SERVICE_JWT_TTL_SECONDS=
