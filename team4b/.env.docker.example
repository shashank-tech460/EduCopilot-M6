# Team 4B — Docker environment example (Task 11.1).
#
# Copy to `.env` alongside docker-compose.yml (the PRODUCTION-oriented
# compose file -- Team 4B's API container only). Do NOT use localhost
# for any of these three URLs; the values here are inter-container/
# host-network values, not the same as .env.example's plain-Python-
# process defaults.
#
# For an isolated, fully self-contained dev stack instead (bundles its
# own Qdrant/Redis/Ollama, no Team 4A stack required), use
# docker-compose.dev.yml -- it does not read this file at all (its
# service URLs are hardcoded to its own bundled container names).
#
# TWO WAYS TO REACH TEAM 4A'S REAL, ALREADY-RUNNING QDRANT/REDIS:
#
# OPTION A -- join Team 4A's Docker network (recommended when both
# stacks run on the same host). Find Team 4A's actual network name
# first: `docker network ls` (commonly named after Team 4A's compose
# project, e.g. "4a-service_default" -- verify the exact name on your
# own machine rather than assuming it). Then either add that network to
# docker-compose.yml's team4b-api service as an external network, or
# simply point at Team 4A's container names if this container joins
# that same network:
#
#   QDRANT_URL=http://4a-service-qdrant-1:6333
#   REDIS_URL=redis://4a-service-redis-1:6379/0
#
# OPTION B -- reach Team 4A's stack via its HOST-EXPOSED ports instead
# (simpler, no shared Docker network needed, works if Team 4A's compose
# file already publishes Qdrant/Redis to the host). From inside another
# container, the host itself is commonly reachable as
# "host.docker.internal" (Docker Desktop) or the host's LAN/bridge IP
# on Linux -- verify which applies to your actual environment rather
# than assuming Docker Desktop's convention everywhere:
#
#   QDRANT_URL=http://host.docker.internal:6333
#   REDIS_URL=redis://host.docker.internal:6379/0
#
# Pick ONE option above and uncomment/adjust it -- these are examples,
# not defaults; docker-compose.yml requires QDRANT_URL/REDIS_URL/
# OLLAMA_URL to be set explicitly (no silent fallback to localhost or
# to the values in this file).

QDRANT_URL=http://4a-service-qdrant-1:6333
QDRANT_COLLECTION_NAME=team4b_shared_production_chunks
EMBEDDING_DIMENSIONS=384
EMBEDDING_DISTANCE=Cosine
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

REDIS_URL=redis://4a-service-redis-1:6379/0

# Ollama has never been something Team 4B "owns" in this architecture
# (see app/services/llm_generator.py) -- it is an external/host-level
# dependency throughout. If it runs on the Docker host itself:
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL_NAME=llama3

ENVIRONMENT=production
LOG_LEVEL=INFO

# Optional: only needed if you must join Team 4A's Docker network by
# name from a tool/script outside docker-compose.yml itself; the
# compose file does not read this variable directly.
TEAM4A_NETWORK_NAME=4a-service_default

# Optional host-port overrides (container always listens on 8000
# internally regardless of this value):
TEAM4B_HOST_PORT=8000
