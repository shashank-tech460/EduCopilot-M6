# Team 4B — example environment overrides.
# Copy to .env and adjust for local/staging/production. Every value below
# has a working default in app/core/config.py if omitted.

ENVIRONMENT=local
LOG_LEVEL=INFO

# Vector_Store / Qdrant -- shared production collection (see docs/CONTRACT_DECISIONS.md)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=team4b_shared_production_chunks
EMBEDDING_DIMENSIONS=384
EMBEDDING_DISTANCE=Cosine
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Hybrid_Retriever
RRF_K=60

# Retrieval_Config defaults
DEFAULT_TOP_K=5
DEFAULT_SCORE_THRESHOLD=0.3
DEFAULT_SEARCH_MODE=hybrid

# LLM_Generator / Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL_NAME=llama3

# Conversation_Manager / Redis
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_MINUTES=30
CONVERSATION_WINDOW_SIZE=5

# Evaluation_Pipeline / RAGAS
EVALUATION_BATCH_MAX_SIZE=50
EVALUATION_BATCH_TIMEOUT_SECONDS=60
FAITHFULNESS_FLAG_THRESHOLD=0.5

# ---------------------------------------------------------------------------
# Phase 2B internal service JWT -- verification-only configuration.
# Team 4B NEVER holds a private signing key; only Team 4C mints tokens.
# ---------------------------------------------------------------------------
SERVICE_JWT_EXPECTED_ISSUER=https://educopilot.internal
SERVICE_JWT_EXPECTED_AUDIENCE=team4b-query
SERVICE_JWT_REQUIRED_SCOPE=query
SERVICE_JWT_CLOCK_SKEW_SECONDS=30

# SERVICE_JWT_PUBLIC_KEYS_JSON must be a JSON object of
# {kid: PEM_public_key_string} -- e.g.:
#   {"my-kid-1": "-----BEGIN PUBLIC KEY-----\nMFkw...\n-----END PUBLIC KEY-----\n"}
#
# COMMON MISTAKE (diagnosed during MVP M6 local-stack setup): exporting
# the key as a JWK (a JSON *object* -- {"kty":"EC","crv":"P-256","x":...,
# "y":...,...}) instead of a PEM *string*. `load_public_keys_json`
# (app/security/service_jwt.py) requires every value to be a plain PEM
# string and will reject a JWK object with:
#   "service_jwt_public_keys_json must be a JSON object of {kid: PEM string}"
#
# If you already have a JWK-shaped value and want to convert it to the
# correct PEM format WITHOUT generating a new key, run:
#   python scripts/fix_service_jwt_public_keys_json.py --from-env
# (or --input <file> / via stdin -- see that script's own docstring).
#
# On the Team 4C (signing) side, the correct export function is `jose`'s
# `exportSPKI(publicKey)` (see scripts/interop-generate-tokens.ts in the
# Team 4C repository for a working example) -- not `exportJWK()`.
SERVICE_JWT_PUBLIC_KEYS_JSON={}
